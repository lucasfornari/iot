# Copie este arquivo para .env (que fica fora do git) e preencha.
# Os valores são embutidos no firmware na hora de compilar (pio run).

# Rede Wi-Fi 2.4 GHz (ESP32 não conecta em 5 GHz)
WIFI_SSID=
WIFI_SENHA=

# Sinric Pro: portal.sinric.pro > Credentials (App Key / App Secret)
SINRIC_APP_KEY=
SINRIC_APP_SECRET=

# Sinric Pro: Devices > dispositivo do tipo "Temperature Sensor" > Device ID
SINRIC_DEVICE_ID=
