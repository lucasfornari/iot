WIFI_SSID=SENAC_WIFI
WIFI_SENHA=x1y2z3@snc24

# Sinric Pro: portal.sinric.pro > Credentials (App Key / App Secret)
SINRIC_APP_KEY=227846b4-e7f2-4dcd-9bb9-f89edf7011f2
SINRIC_APP_SECRET=a9972122-3365-4a3f-b8df-1a78b28d9e9a-75de4095-85cd-4c92-8f20-aba3244d5015

# Sinric Pro: Devices > dispositivo do tipo "Temperature Sensor" > Device ID
SINRIC_DEVICE_ID=6afddaa09ea140585cb1b97d

# Sinric Pro: dispositivo personalizado com valor "Umidade" (opcional)
SINRIC_DEVICE_ID_UMIDADE=6afe2a6b7d04ce9fd657a05c
SINRIC_INSTANCIA_UMIDADE=rangeInstance1

# Sinric Pro: dispositivo "Switch" do LED (GPIO25)
